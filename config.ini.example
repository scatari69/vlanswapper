# Copy to config.ini and fill in. You can omit the IP here and pass it via
# --host or answer it in the dialog (combined mode).
# Passwords can be moved to the VLANSWAPPER_PASSWORD / _ENABLE environment variables.

[switch]
username = admin
password = secret
# enable_password = secret        ; only for Cisco-like devices (Eltex/BDCOM) if the prompt ends with >
# host = 192.0.2.10               ; optional; passing --host is more convenient
port = 23
timeout = 10
